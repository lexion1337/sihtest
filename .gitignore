# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]

# --- Derived artifacts ---
# skills.db is rebuilt from data/*.jsonl by pipeline.py in seconds.
# The JSONL files ARE committed: reproducibility is part of the pitch.
*.db
*.sqlite3

# Raw scrape/fetch cache (see scraper.py TODO). Can get large; keep it local.
data/raw/

# NOTE on data/postings_real.jsonl and data/recall_review.md:
# These hold verbatim third-party job text (Postman, Meesho, CRED). They were
# held back while this repo was public, because redistributing someone else's
# copyrighted postings is a different act from reading a public API for
# research. The repo is now PRIVATE (verified 2026-09-15), so they are
# committed for reproducibility.
#
# IF THIS REPO IS EVER MADE PUBLIC, re-add both paths here and git rm --cached
# them first. `python ingest_ats.py` regenerates both in about ten seconds.

# --- Secrets / local config ---
.claude.json
.env

# --- OS ---
.DS_Store
Thumbs.db
