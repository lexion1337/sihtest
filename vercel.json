{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{data/**,static/**,tools/**,*.py}",
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
